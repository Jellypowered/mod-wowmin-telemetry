[worldserver]

########################################
# WoWMin telemetry
########################################
#
#    WowMinTelemetry.Enable
#        Description: Enables text snapshot/event collection and the administrator-only
#                     "wowmin telemetry" command over the existing authenticated
#                     worldserver command transport. Disabled skips collection;
#                     existing bounded history is retained until map destruction.
#                     Lifecycle bookkeeping and cleanup remain active.
#        Default:     0 - Disabled
#                     1 - Enabled
#

WowMinTelemetry.Enable = 0

#
#    WowMinTelemetry.Stream.Enable
#        Description: Enables the "wowmin stream" command and the UDP position
#                     stream. A session streams only while a client keeps
#                     renewing its subscription (every few seconds), and only to
#                     the destination below; commands cannot redirect it.
#                     Besides positions it carries movement paths, creatures,
#                     how each unit looks (display, gear, sheathed weapons) for
#                     drawing models, and, with mod-playerbots, what each bot
#                     is deciding.
#                     Requires WowMinTelemetry.Enable. Disabling either option on
#                     reload discards active subscriptions and queued stream data;
#                     re-enabling requires new subscriptions. Text history is retained.
#                     The world thread drains a 2048-datagram queue after map updates.
#                     Batches that cannot fit are dropped whole; reload discards the queue.
#        Default:     0 - Disabled
#                     1 - Enabled
#

WowMinTelemetry.Stream.Enable = 0

#
#    WowMinTelemetry.Stream.Host
#    WowMinTelemetry.Stream.Port
#        Description: Destination for stream datagrams: the machine and UDP port
#                     wowmin listens on (WOWMIN_STREAM_PORT). Use an IP address,
#                     not a host name. Keep this on localhost or a trusted
#                     network; datagrams are not encrypted. Failed validation or
#                     socket opening retries at most every five seconds while watched.
#                     Changing host/port retries immediately; no fallback is used.
#        Default:     "127.0.0.1", 7979
#

WowMinTelemetry.Stream.Host = "127.0.0.1"
WowMinTelemetry.Stream.Port = 7979

#
#    WowMinTelemetry.Stream.IntervalMs
#        Description: Milliseconds between position snapshots for each subscribed
#                     session. The effective rate is also limited by the map
#                     update rate. Minimum 20.
#        Default:     100 (10 updates per second)
#

WowMinTelemetry.Stream.IntervalMs = 100
